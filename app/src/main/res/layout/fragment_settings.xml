<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Время первой перекура" />

        <Button
            android:id="@+id/btn_first_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:drawableLeft="@drawable/ic_timer" />  <!-- Иконка часов -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Время последней перекура" />

        <Button
            android:id="@+id/btn_last_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="22:00"
            android:drawableLeft="@drawable/ic_timer" />

        <TextView
            android:id="@+id/tv_awake_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вы бодрствуете (расчёт)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Длительность перекура (мин)" />

        <SeekBar
            android:id="@+id/seek_increase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Количество сигарет" />

        <SeekBar
            android:id="@+id/seek_cigs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="5" />

        <TextView
            android:id="@+id/tv_interval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вы курите каждые (расчёт) минут" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Стоимость пачки сигарет" />

        <EditText
            android:id="@+id/et_pack_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="100 €" />

        <TextView
            android:id="@+id/tv_cig_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Одна сигарета стоит (расчёт)" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:backgroundTint="@color/light_green" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Начать сначала" />

    </LinearLayout>
</ScrollView>